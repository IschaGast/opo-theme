{
  "manifest_version": 2,
  "name": "Opo",
  "version": "1.0.0",
  "description": "Colorblind-safe, OKLCH-based accessible theme. Follows the Firefox light/dark setting.",
  "author": "Ischa Gast",
  "homepage_url": "https://github.com/IschaGast/opo-theme",
  "browser_specific_settings": {
    "gecko": {
      "id": "opo-theme@ischagast"
    }
  },
  "theme": {
    "colors": {
      "frame": "#eeeae2",
      "frame_inactive": "#f5f2eb",
      "tab_background_text": "#57606a",
      "tab_selected": "#fbf8f2",
      "tab_text": "#24292f",
      "tab_line": "#005ccc",
      "tab_loading": "#005ccc",
      "toolbar": "#fbf8f2",
      "toolbar_text": "#24292f",
      "toolbar_top_separator": "#eeeae2",
      "toolbar_bottom_separator": "#eeeae2",
      "toolbar_vertical_separator": "#eeeae2",
      "toolbar_field": "#f5f2eb",
      "toolbar_field_text": "#24292f",
      "toolbar_field_border": "#57606a59",
      "toolbar_field_focus": "#fbf8f2",
      "toolbar_field_text_focus": "#24292f",
      "toolbar_field_border_focus": "#005ccc",
      "toolbar_field_highlight": "#005ccc",
      "toolbar_field_highlight_text": "#fbf8f2",
      "popup": "#fbf8f2",
      "popup_text": "#24292f",
      "popup_border": "#eeeae2",
      "popup_highlight": "#005ccc",
      "popup_highlight_text": "#fbf8f2",
      "sidebar": "#f5f2eb",
      "sidebar_text": "#24292f",
      "sidebar_border": "#eeeae2",
      "sidebar_highlight": "#005ccc",
      "sidebar_highlight_text": "#fbf8f2",
      "ntp_background": "#fbf8f2",
      "ntp_card_background": "#f5f2eb",
      "ntp_text": "#24292f",
      "icons": "#57606a",
      "icons_attention": "#005ccc",
      "button_background_hover": "#eeeae2",
      "button_background_active": "#005ccc17"
    }
  },
  "dark_theme": {
    "colors": {
      "frame": "#1c1a14",
      "frame_inactive": "#191612",
      "tab_background_text": "#99a3ae",
      "tab_selected": "#161410",
      "tab_text": "#d1d7df",
      "tab_line": "#79afff",
      "tab_loading": "#79afff",
      "toolbar": "#161410",
      "toolbar_text": "#d1d7df",
      "toolbar_top_separator": "#1c1a14",
      "toolbar_bottom_separator": "#1c1a14",
      "toolbar_vertical_separator": "#1c1a14",
      "toolbar_field": "#191612",
      "toolbar_field_text": "#d1d7df",
      "toolbar_field_border": "#99a3ae59",
      "toolbar_field_focus": "#161410",
      "toolbar_field_text_focus": "#d1d7df",
      "toolbar_field_border_focus": "#79afff",
      "toolbar_field_highlight": "#79afff",
      "toolbar_field_highlight_text": "#161410",
      "popup": "#161410",
      "popup_text": "#d1d7df",
      "popup_border": "#1c1a14",
      "popup_highlight": "#79afff",
      "popup_highlight_text": "#161410",
      "sidebar": "#191612",
      "sidebar_text": "#d1d7df",
      "sidebar_border": "#1c1a14",
      "sidebar_highlight": "#79afff",
      "sidebar_highlight_text": "#161410",
      "ntp_background": "#161410",
      "ntp_card_background": "#191612",
      "ntp_text": "#d1d7df",
      "icons": "#99a3ae",
      "icons_attention": "#79afff",
      "button_background_hover": "#1c1a14",
      "button_background_active": "#79afff33"
    }
  }
}